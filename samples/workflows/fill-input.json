{
  "schemaVersion": 1,
  "name": "fill-input",
  "inputs": {
    "value": {
      "type": "string",
      "required": true,
      "sensitive": true
    }
  },
  "steps": [
    {
      "id": "fill-value",
      "action": "fill",
      "target": {
        "key": "text_input"
      },
      "text": {
        "input": "value"
      }
    },
    {
      "id": "observe",
      "action": "snapshot"
    }
  ]
}
