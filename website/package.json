{
  "name": "marionette-agent-docs",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run --bun astro dev --host 127.0.0.1",
    "check": "bun run --bun astro check && bun scripts/check-content.mjs && bun scripts/check-repository-docs.mjs",
    "build": "bun run --bun astro build && bun scripts/check-site.mjs",
    "preview": "bun run --bun astro preview --host 127.0.0.1",
    "test": "bun run --bun playwright test",
    "format": "bun run --bun prettier --write .",
    "format:check": "bun run --bun prettier --check .",
    "verify": "bun run format:check && bun run check && bun run build && bun run test"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.2",
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "cheerio": "1.2.0",
    "github-slugger": "2.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
