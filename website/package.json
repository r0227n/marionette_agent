{
  "name": "marionette-agent-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && node scripts/check-content.mjs",
    "build": "astro build && node scripts/check-site.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run check && npm run build && npm test"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.2",
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "cheerio": "1.2.0",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
