---
import { site, base } from '../../site.config.mjs';
const destination = `${base}/ja/`;
---

<!doctype html>
<html lang="ja" data-pagefind-ignore>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={`${site}${destination}`} />
    <title>marionette-agent documentation</title>
  </head>
  <body>
    <p>
      <a href={destination}>日本語ドキュメントへ</a> · <a
        href={`${base}/en/`}
        lang="en">English documentation</a
      >
    </p>
  </body>
</html>
